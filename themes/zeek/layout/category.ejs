<%
/* 分类聚合页（对照原型 viewArchive 单组形态）：复用归档列表渲染，标题为该分类。
 * 两级分类（OB-ENG-SOP-06）：面包屑 首页 / 分类 / 领域 / 细分；领域页列出下属细分 chips。 */
const catName = page.category || page.name || '';
/* page.category 是名称字符串；回查 site.categories 拿对象，才能上溯 parent 拼面包屑链 */
const catObj = typeof page.category === 'string'
  ? site.categories.findOne({ name: page.category })
  : (page.category || null);
const items = [];
if (page.posts) page.posts.each((p) => items.push(p));
const tree = catTree(site);
const chain = [];
(function () {
  let c = catObj;
  while (c) { chain.unshift(c); c = c.parent ? site.categories.findOne({ _id: c.parent }) : null; }
})();
const isRoot = chain.length <= 1;
const kids = isRoot && catObj
  ? (tree.childrenOf.get(catObj._id) || [])
  : [];
%>

<div class="crumb">
  <a href="<%- url_for('') %>">首页</a> / <a href="<%- url_for('categories/') %>">分类</a> /
  <% chain.forEach((c, i) => { %>
    <% if (i < chain.length - 1) { %><a href="<%- url_for(c.path) %>"><%= c.name %></a> / <% } else { %><span><%= c.name %></span><% } %>
  <% }) %>
</div>
<h1 style="font-size:26px;margin-bottom:6px"><%= catIcon(catName) %> <%= catName %></h1>
<p style="color:var(--text-2);margin-bottom:18px"><%= isRoot ? '领域' : '分类' %>「<%= catName %>」下共 <%= items.length %> 篇文档<%= isRoot ? '，含下属全部分类' : '' %>。</p>

<% if (kids.length) { %>
<div class="cat-chips">
  <% kids.forEach((c) => { %><a class="chip" href="<%- url_for(c.path) %>"><%= catIcon(c.name) %> <%= c.name %><b><%= c.length %></b></a><% }) %>
</div>
<% } %>

<details class="archgroup" open><summary><%= catIcon(catName) %> <%= catName %><span class="cnt"><%= items.length %> 篇</span></summary>
  <div class="archlist">
    <% items.forEach((p) => { %>
    <a href="<%- url_for(p.path) %>"><span class="ad"><%= p.date.format('YYYY-MM-DD') %></span><span><%= p.title %></span>
      <span class="ai-sub"><%= p.description || '' %></span></a>
    <% }) %>
  </div></details>

<% if (page.total > 1) { %>
<div class="pager">
  <% if (page.prev) { %><a href="<%- url_for(page.prev_link) %>">上一页（第 <%= page.current - 1 %> 页）</a><% } else { %><span style="flex:1"></span><% } %>
  <% if (page.next) { %><a class="next" href="<%- url_for(page.next_link) %>">下一页（第 <%= page.current + 1 %> 页）</a><% } else { %><span style="flex:1"></span><% } %>
</div>
<% } %>
