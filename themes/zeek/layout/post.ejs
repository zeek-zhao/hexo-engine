<%
/* 文章页（对照原型 viewArticle）：面包屑 + meta + 正文（含 ¶ 锚点）+ author-card + 上一篇/下一篇。
 * TOC 侧栏由 layout.ejs 用同一 heads() 解析结果渲染，保证 id 一致。 */
const th = heads(page.content);
/* JSON-LD 结构化数据（第七轮）：BlogPosting + BreadcrumbList，供搜索引擎富摘要 */
const ldPost = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: page.title,
  description: page.description || '',
  datePublished: date(page.date, 'YYYY-MM-DD[T]HH:mm:ssZ'),
  dateModified: date(page.updated || page.date, 'YYYY-MM-DD[T]HH:mm:ssZ'),
  author: { '@type': 'Person', name: 'zeek.zhao', url: full_url_for('about/') },
  mainEntityOfPage: { '@type': 'WebPage', '@id': full_url_for(page.path || '') },
  url: full_url_for(page.path || '')
};
let ldCrumb = null;
/* 两级分类（OB-ENG-SOP-06）：面包屑 首页 / 归档 / 领域 / 细分 / 标题 */
const pcs = []; page.categories.each((c) => pcs.push(c));
const leaf = pcs.length ? pcs[pcs.length - 1] : null;
const tree = catTree(site);
const chain = [];
(function () {
  let c = leaf;
  while (c) { chain.unshift(c); c = c.parent ? site.categories.findOne({ _id: c.parent }) : null; }
})();
ldCrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: full_url_for('') },
    { '@type': 'ListItem', position: 2, name: '归档', item: full_url_for('archives/') }
  ].concat(chain.map((c, i) => ({ '@type': 'ListItem', position: 3 + i, name: c.name, item: full_url_for(c.path) })))
    .concat([{ '@type': 'ListItem', position: 3 + chain.length, name: page.title, item: full_url_for(page.path || '') }])
};
%>

<div class="crumb"><a href="<%- url_for('') %>">首页</a> / <a href="<%- url_for('archives/') %>">归档</a><% chain.forEach((c) => { %> / <a href="<%- url_for(c.path) %>"><%= catIcon(c.name) %> <%= c.name %></a><% }) %> / <span><%= page.title %></span></div>

<h1><%= page.title %></h1>
<% if (page.description) { %><div class="subtitle"><%= page.description %></div><% } %>
<div class="article-meta">
  <span>📅 <%= date(page.date, 'YYYY-MM-DD') %></span><span>· 更新于 <%= date(page.updated || page.date, 'YYYY-MM-DD') %></span>
  <span class="meta-wc" title="中文字 + 西文词">· <%= wordCount(page.content) %> 字 · 约 <%= readMin(page.content) %> 分钟</span>
  <a class="meta-author" href="<%- url_for('about/') %>">✍ zeek.zhao</a>
  <% page.tags.each((t) => { %><a class="tagchip" href="<%- url_for(t.path) %>">#<%= t.name %></a><% }) %>
  <button type="button" class="copy-link" data-url="<%- full_url_for(page.path || '') %>" title="复制本文链接">🔗 复制链接</button>
</div>

<%- th.body %>

<a class="author-card" href="<%- url_for('about/') %>">
  <span class="avatar sm" aria-hidden="true">Z</span>
  <span class="ac-text"><b>zeek.zhao</b><span class="ac-sub">嵌入式与 DevOps 工程师 · 折腾 Yocto、CI 与 Obsidian 知识管理</span></span>
  <span class="ac-go">查看个人主页 →</span>
</a>

<div class="pager">
  <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><span class="pg-label">← 上一篇</span><%= page.prev.title %></a><% } else { %><span style="flex:1"></span><% } %>
  <% if (page.next) { %><a class="next" href="<%- url_for(page.next.path) %>"><span class="pg-label">下一篇 →</span><%= page.next.title %></a><% } else { %><span style="flex:1"></span><% } %>
</div>

<% /* 评论 giscus（GitHub Discussions）：容器由 main.js 进入视口后懒加载脚本 */ %>
<% if (config.zeek && config.zeek.giscus) { %>
<section class="comments" id="giscusWrap" aria-label="评论">
  <div class="comments-title">评论</div>
  <div class="giscus-box" id="giscusBox"><noscript>评论需要启用 JavaScript（giscus 基于 GitHub Discussions）。</noscript></div>
</section>
<% } %>

<% /* JSON-LD 结构化数据（搜索引擎富摘要）：BlogPosting + BreadcrumbList */ %>
<script type="application/ld+json"><%- JSON.stringify(ldPost) %></script>
<script type="application/ld+json"><%- JSON.stringify(ldCrumb) %></script>
