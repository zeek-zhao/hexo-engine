<%
/* 标签聚合页（对照原型 viewArchive 单组形态）：复用归档列表渲染，标题为该标签 */
const tagName = page.tag || page.name || '';
const items = [];
if (page.posts) page.posts.each((p) => items.push(p));
%>

<div class="crumb"><a href="<%- url_for('') %>">首页</a> / <a href="<%- url_for('tags/') %>">标签</a> / <span>#<%= tagName %></span></div>
<h1 style="font-size:26px;margin-bottom:6px">#<%= tagName %></h1>
<p style="color:var(--text-2);margin-bottom:18px">标签「<%= tagName %>」下共 <%= items.length %> 篇文档。</p>

<details class="archgroup" open><summary>#<%= tagName %><span class="cnt"><%= items.length %> 篇</span></summary>
  <div class="archlist">
    <% items.forEach((p) => { %>
    <a href="<%- url_for(p.path) %>"><span class="ad"><%= p.date.format('YYYY-MM-DD') %></span><span><%= p.title %></span>
      <span class="ai-sub"><%= p.description || '' %></span></a>
    <% }) %>
  </div></details>

<% if (page.total > 1) { %>
<div class="pager">
  <% if (page.prev) { %><a href="<%- url_for(page.prev_link) %>">上一页（第 <%= page.current - 1 %> 页）</a><% } else { %><span style="flex:1"></span><% } %>
  <% if (page.next) { %><a class="next" href="<%- url_for(page.next_link) %>">下一页（第 <%= page.current + 1 %> 页）</a><% } else { %><span style="flex:1"></span><% } %>
</div>
<% } %>
